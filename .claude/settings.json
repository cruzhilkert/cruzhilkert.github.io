{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pgrep -f 'browser-sync start' > /dev/null || (cd \"${CLAUDE_PROJECT_DIR:-$PWD}\" && PATH=\"$HOME/.local/share/mise/shims:$PATH\" browser-sync start --server --port 3000 --files '*.html' --no-open > /tmp/browser-sync-game.log 2>&1 &)",
            "async": true,
            "statusMessage": "Starting browser-sync on http://localhost:3000 ..."
          }
        ]
      }
    ]
  }
}
